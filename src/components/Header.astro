---
import { blogNavigation, navigation, site } from '../data/site';
import MaterialIcon from './MaterialIcon.astro';
interface Props { section?: 'main' | 'blog'; }
const { section = 'main' } = Astro.props;
const isBlog = section === 'blog';
const links = isBlog ? blogNavigation : navigation;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const activeHref = links
  .filter(({ href }) => {
    const target = href.replace(/\/$/, '') || '/';
    return path === target || (target !== '/' && path.startsWith(`${target}/`));
  })
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
---
<header class:list={['site-header', { 'blog-header': isBlog }]}>
  <div class="container header-inner">
    <a class="wordmark" href={isBlog ? "/blog/" : "/"} aria-label={`${site.name} ${isBlog ? "Blog" : "Home"}`}>{site.name}<span aria-hidden="true">.</span>{isBlog && <span class="blog-brand">Blog</span>}</a>
    <nav aria-label={isBlog ? "Blog navigation" : "Main navigation"}>
      {links.map(({ href, label }) => (
        <a href={href} aria-current={path === (href.replace(/\/$/, '') || '/') ? 'page' : href === activeHref ? 'location' : undefined}>
          {isBlog && href === '/' && <MaterialIcon name="arrow_back" class="nav-icon" />}
          {label}
          {!isBlog && href === '/blog/' && <MaterialIcon name="north_east" class="nav-icon" />}
        </a>
      ))}
      <span class="nav-indicator" aria-hidden="true" hidden></span>
    </nav>
    <button class="theme-toggle" data-liquid-glass type="button" aria-label="Theme: Auto. Switch to Light mode" title="Theme: Auto. Switch to Light mode" hidden>
      <MaterialIcon name="desktop_windows" class="auto-icon" />
      <MaterialIcon name="dark_mode" class="moon-icon" />
      <MaterialIcon name="light_mode" class="sun-icon" />
    </button>
  </div>
</header>
<style>
  @media (max-width: 900px) {
    .blog-header .header-inner { flex-wrap: wrap; gap: 16px; padding-block: 16px 12px; }
    .blog-header nav { order: 3; width: 100%; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; }
  }
  @media (max-width: 560px) {
    .blog-header nav { flex-wrap: nowrap; gap: 8px; font-size: 12px; }
  }
</style>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const reportHeaderHeight = () => {
      document.documentElement.style.setProperty('--header-height', `${Math.ceil(header.getBoundingClientRect().height)}px`);
    };
    reportHeaderHeight();
    if ('ResizeObserver' in window) new ResizeObserver(reportHeaderHeight).observe(header);
  }

  const nav = header?.querySelector<HTMLElement>('nav');
  const indicator = nav?.querySelector<HTMLElement>('.nav-indicator');
  if (nav && indicator) {
    const navLinks = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
    const currentLink = navLinks.find((link) => link.hasAttribute('aria-current')) ?? null;
    let hoveredLink: HTMLAnchorElement | null = null;
    let focusedLink: HTMLAnchorElement | null = null;
    let targetLink = currentLink;

    const positionIndicator = () => {
      if (!targetLink) {
        indicator.style.opacity = '0';
        return;
      }
      const navBounds = nav.getBoundingClientRect();
      const linkBounds = targetLink.getBoundingClientRect();
      if (!linkBounds.width || !navBounds.width) return;
      nav.style.setProperty('--indicator-x', `${linkBounds.left - navBounds.left}px`);
      nav.style.setProperty('--indicator-width', `${linkBounds.width}px`);
      indicator.style.opacity = '1';
      indicator.hidden = false;
      nav.dataset.indicatorReady = 'true';
    };
    const moveIndicator = (link: HTMLAnchorElement | null) => {
      targetLink = link;
      positionIndicator();
    };

    positionIndicator();
    for (const link of navLinks) {
      link.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'touch') return;
        hoveredLink = link;
        moveIndicator(link);
      });
      link.addEventListener('focus', () => {
        focusedLink = link;
        moveIndicator(link);
      });
    }
    nav.addEventListener('pointerleave', () => {
      hoveredLink = null;
      moveIndicator(focusedLink ?? currentLink);
    });
    nav.addEventListener('focusout', (event) => {
      focusedLink = navLinks.find((link) => link === event.relatedTarget) ?? null;
      moveIndicator(focusedLink ?? hoveredLink ?? currentLink);
    });
    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver(positionIndicator);
      observer.observe(nav);
      navLinks.forEach((link) => observer.observe(link));
    }
    document.fonts.ready.then(positionIndicator);
  }

  type ThemeMode = 'auto' | 'light' | 'dark';
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const modes: ThemeMode[] = ['auto', 'light', 'dark'];
  const labels = { auto: 'Auto', light: 'Light', dark: 'Dark' };
  const saved = document.documentElement.dataset.themeMode;
  let mode: ThemeMode = saved === 'light' || saved === 'dark' ? saved : 'auto';

  const update = () => {
    document.documentElement.dataset.themeMode = mode;
    document.documentElement.dataset.theme = mode === 'dark' || (mode === 'auto' && media.matches) ? 'dark' : 'light';
    const next = modes[(modes.indexOf(mode) + 1) % modes.length];
    if (button) {
      const label = `Theme: ${labels[mode]}. Switch to ${labels[next]} mode`;
      button.setAttribute('aria-label', label);
      button.title = label;
    }
  };
  update();
  if (button) button.hidden = false;
  button?.addEventListener('click', () => {
    mode = modes[(modes.indexOf(mode) + 1) % modes.length];
    update();
    try { localStorage.setItem('theme', mode); } catch {}
  });
  media.addEventListener('change', () => {
    if (mode === 'auto') update();
  });
</script>

<style>
  nav { position: relative; }
  nav a { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
  .nav-indicator {
    position: absolute; left: 0; bottom: -2px; width: var(--indicator-width, 0px); height: 2px;
    border-radius: 999px; background: var(--accent); pointer-events: none; opacity: 0;
    transform: translateX(var(--indicator-x, 0px));
    transition: transform 240ms cubic-bezier(.22, 1, .36, 1), width 240ms cubic-bezier(.22, 1, .36, 1), opacity 160ms ease;
  }
  :global(.nav-icon) { color: var(--muted); font-size: 16px; }
  .blog-brand { margin-left: 10px; color: var(--muted); font-size: 14px; font-weight: 400; letter-spacing: 0; }
  @media (max-width: 700px) {
    .header-inner { min-height: 108px; gap: 16px; flex-wrap: wrap; padding: 16px 0 12px; }
    nav { order: 3; width: 100%; justify-content: space-between; gap: 12px; }
    nav a { padding: 3px 0; }
  }
  @media (max-width: 380px) {
    nav { gap: 8px; font-size: 13px; }
    nav a { gap: 4px; }
  }
</style>
