---
import { blogNavigation, navigation, site } from '../data/site';
interface Props { section?: 'main' | 'blog'; }
const { section = 'main' } = Astro.props;
const isBlog = section === 'blog';
const links = isBlog ? blogNavigation : navigation;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href={isBlog ? "/blog/" : "/"} aria-label={`${site.name} ${isBlog ? "Blog" : "Home"}`}>{site.name}<span aria-hidden="true">.</span>{isBlog && <span class="blog-brand">Blog</span>}</a>
    <nav aria-label={isBlog ? "Blog navigation" : "Main navigation"}>
      {links.map(({ href, label }) => (
        <a href={href} aria-current={path === (href.replace(/\/$/, '') || '/') ? 'page' : undefined}>
          {isBlog && href === '/' && <svg class="nav-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5-4 4 4 4M5 9h9a5 5 0 0 1 0 10h-3" /></svg>}
          {label}
          {!isBlog && href === '/blog/' && <svg class="nav-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg>}
        </a>
      ))}
    </nav>
    <button class="theme-toggle" type="button" aria-label="Theme: Auto. Switch to Light mode" title="Theme: Auto. Switch to Light mode" hidden>
      <svg class="auto-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8m-4-4v4" /></svg>
      <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" /></svg>
      <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
    </button>
  </div>
</header>
<script>
  type ThemeMode = 'auto' | 'light' | 'dark';
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const modes: ThemeMode[] = ['auto', 'light', 'dark'];
  const labels = { auto: 'Auto', light: 'Light', dark: 'Dark' };
  const saved = document.documentElement.dataset.themeMode;
  let mode: ThemeMode = saved === 'light' || saved === 'dark' ? saved : 'auto';

  const update = () => {
    document.documentElement.dataset.themeMode = mode;
    document.documentElement.dataset.theme = mode === 'dark' || (mode === 'auto' && media.matches) ? 'dark' : 'light';
    const next = modes[(modes.indexOf(mode) + 1) % modes.length];
    if (button) {
      const label = `Theme: ${labels[mode]}. Switch to ${labels[next]} mode`;
      button.setAttribute('aria-label', label);
      button.title = label;
    }
  };
  update();
  if (button) button.hidden = false;
  button?.addEventListener('click', () => {
    mode = modes[(modes.indexOf(mode) + 1) % modes.length];
    update();
    try { localStorage.setItem('theme', mode); } catch {}
  });
  media.addEventListener('change', () => {
    if (mode === 'auto') update();
  });
</script>

<style>
  nav a { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
  .nav-icon { flex-shrink: 0; color: var(--muted); }
  .blog-brand { margin-left: 10px; color: var(--muted); font-size: 14px; font-weight: 400; letter-spacing: 0; }
  @media (max-width: 700px) {
    .header-inner { min-height: 108px; gap: 16px; flex-wrap: wrap; padding: 16px 0 12px; }
    nav { order: 3; width: 100%; justify-content: space-between; gap: 12px; }
    nav a { padding: 3px 0; }
  }
</style>
