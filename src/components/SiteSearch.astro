---
const pages = [
  { href: '/blog/', title: 'Blog', keywords: 'essays notes writing articles archive' },
  { href: '/about/', title: 'About me', keywords: 'about personal introduction aydrthn' },
  { href: '/projects/', title: 'My projects', keywords: 'projects portfolio website astro typescript css' },
  { href: '/experience/', title: 'My journey', keywords: 'experience work learning education' },
];
---
<div class="site-search">
  <form class="search-bar" role="search">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
    <input type="search" name="q" aria-label="Search site pages" placeholder="Search this site…" autocomplete="off" aria-controls="search-results" />
    <button type="submit" aria-label="Search"><span aria-hidden="true">→</span></button>
  </form>
  <div class="search-results" id="search-results" hidden>
    <ul>
      {pages.map((page) => <li data-keywords={`${page.title} ${page.keywords}`}><a href={page.href}>{page.title}<span aria-hidden="true">↗</span></a></li>)}
    </ul>
    <p class="search-status" role="status" aria-live="polite"></p>
  </div>
  <noscript><p class="search-status">Enable JavaScript to search this site.</p></noscript>
</div>
<script>
  const search = document.querySelector<HTMLElement>('.site-search');
  const form = search?.querySelector('form');
  const input = search?.querySelector('input');
  const results = search?.querySelector<HTMLElement>('.search-results');
  const status = search?.querySelector<HTMLElement>('.search-status');
  const items = Array.from(search?.querySelectorAll<HTMLElement>('li') ?? []);
  const filter = () => {
    if (!input || !results || !status) return;
    const query = input.value.trim().toLocaleLowerCase();
    results.hidden = !query;
    let count = 0;
    for (const item of items) {
      item.hidden = !item.dataset.keywords?.toLocaleLowerCase().includes(query);
      if (!item.hidden) count++;
    }
    status.textContent = query ? (count ? `${count} ${count === 1 ? 'page' : 'pages'} found` : 'No matching pages found') : '';
  };
  input?.addEventListener('input', filter);
  input?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && results) results.hidden = true;
  });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    filter();
    if (input?.value.trim()) items.find((item) => !item.hidden)?.querySelector('a')?.focus();
    else input?.focus();
  });
</script>
<style>
  .site-search { position: relative; width: min(480px, 100%); min-width: 0; }
  .search-bar { display: flex; align-items: center; gap: 12px; height: 48px; padding: 0 10px 0 18px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); color: var(--muted); }
  .search-bar:focus-within { border-color: var(--accent); }
  .search-bar svg { flex-shrink: 0; }
  input { width: 100%; min-width: 0; border: 0; outline: none; background: transparent; color: var(--text); font: inherit; font-size: 14px; }
  input::placeholder { color: var(--muted); }
  input:focus-visible { outline: none; }
  button { display: grid; place-items: center; flex-shrink: 0; width: 30px; height: 30px; border: 0; border-radius: 6px; background: var(--soft); color: var(--text); cursor: pointer; }
  .search-results { position: absolute; z-index: 2; top: calc(100% + 8px); width: 100%; padding: 8px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); box-shadow: 0 12px 28px rgb(0 0 0 / 8%); }
  ul { list-style: none; margin: 0; padding: 0; }
  li a { display: flex; justify-content: space-between; padding: 10px; border-radius: 6px; font-size: 14px; }
  li a:hover, li a:focus-visible { background: var(--soft); }
  li a span { color: var(--muted); }
  .search-status { padding: 8px 10px; font-size: 12px; color: var(--muted); }
</style>
