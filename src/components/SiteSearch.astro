---
import { navigation, blogNavigation } from '../data/site';
import { blogCategories, getBlogPosts } from '../lib/blog';
import MaterialIcon from './MaterialIcon.astro';
interface Props { scope?: 'site' | 'blog'; }
const { scope = 'site' } = Astro.props;
const searchLabel = scope === 'blog' ? 'Search articles and tags' : 'Search pages, articles, and tags';
const posts = await getBlogPosts();
const pages = Array.from(new Map([
  ...(scope === 'site' ? [
    ...navigation.map(({ href, label }) => ({ href, title: label, section: href.startsWith('/blog/') ? 'Blog' : 'Page' })),
    ...blogNavigation.filter(({ href }) => href !== '/').map(({ href, label }) => ({ href, title: href === '/blog/' ? 'Blog' : label, section: 'Blog' })),
  ] : []),
  ...posts.map(({ href, entry, category }) => ({
    href, title: entry.data.title, section: `${blogCategories[category].label} article`, description: entry.data.description, tags: entry.data.tags,
  })),
].map((page) => [page.href, page])).values());
---
<div class="site-search" data-search-pages={JSON.stringify(pages)}>
  <form class="search-bar" data-liquid-glass role="search">
    <MaterialIcon name="search" class="search-icon" />
    <input type="search" name="q" aria-label={searchLabel} placeholder={`${searchLabel}…`} autocomplete="off" aria-controls="search-results" />
    <button class="search-submit" type="submit" aria-label="Search"><MaterialIcon name="arrow_forward" /></button>
  </form>
  <div class="search-results" data-liquid-glass id="search-results" aria-busy="false" hidden>
    <div class="search-results-scroll">
      <ul class="search-list" aria-label="Search results"></ul>
      <p class="search-status" role="status" aria-live="polite" aria-atomic="true"></p>
      <button class="search-retry" type="button" hidden>Retry unavailable pages</button>
    </div>
  </div>
  <noscript><p class="search-status">Enable JavaScript to search this site.</p></noscript>
</div>
<script>
  import { startSiteSearch } from '../scripts/site-search';
  document.querySelectorAll<HTMLElement>('.site-search').forEach(startSiteSearch);
</script>
<style>
  .site-search { position: relative; z-index: 2; width: min(480px, 100%); min-width: 0; }
  .search-bar { --glass-radius: 16px; display: flex; align-items: center; gap: 12px; height: 48px; padding: 0 10px 0 18px; color: var(--muted); }
  .search-bar:focus-within { border-color: var(--accent); }
  :global(.search-icon) { font-size: 20px; }
  input { width: 100%; min-width: 0; border: 0; outline: none; background: transparent; color: var(--text); font: inherit; font-size: 14px; }
  input::placeholder { color: var(--muted); }
  input:focus-visible { outline: none; }
  .search-submit { display: grid; place-items: center; flex-shrink: 0; width: 30px; height: 30px; border: 0; border-radius: 6px; background: var(--soft); color: var(--text); cursor: pointer; }
  .search-results { --glass-radius: 22px; position: absolute; z-index: 2; top: calc(100% + 8px); width: 100%; padding: 8px; }
  /* The shared shader samples the scene's solid background, not page content.
     Keep a live DOM backdrop here and blend the shader as a subtle finish. */
  .search-results[data-glass-ready='true'] {
    background: var(--glass-fill);
    -webkit-backdrop-filter: blur(18px) saturate(1.16);
    backdrop-filter: blur(18px) saturate(1.16);
  }
  .search-results[data-glass-ready='true'] > :global(.liquid-glass-canvas) { opacity: 0.16; }
  .search-results-scroll { max-height: min(420px, 60vh, var(--search-room, 420px)); overflow-y: auto; overscroll-behavior: contain; border-radius: calc(var(--glass-radius) - 8px); }
  .search-list { list-style: none; margin: 0; padding: 0; }
  .search-list :global(.search-result-link) { display: block; padding: 12px; border-radius: 10px; font-size: 14px; overflow-wrap: anywhere; }
  .search-list :global(.search-result-link:hover), .search-list :global(.search-result-link:focus-visible) { background: var(--soft); }
  .search-list :global(.search-result-link:focus-visible) { outline-offset: -3px; }
  .search-list :global(.search-result-heading) { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .search-list :global(.search-result-title) { font-weight: 600; line-height: 1.5; }
  .search-list :global(.search-result-section) { display: block; margin-top: 2px; color: var(--muted); font-size: 11px; }
  .search-list :global(.search-result-snippet) { display: block; margin-top: 6px; color: var(--muted); font-size: 12px; line-height: 1.6; }
  .search-list :global(.search-result-tags) { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 0; padding: 0; list-style: none; }
  .search-list :global(.search-result-tags .pill) { max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
  .search-status { margin: 0; padding: 8px 12px; font-size: 12px; color: var(--muted); }
  .search-retry { margin: 2px 12px 10px; padding: 6px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--soft); color: var(--text); font: inherit; font-size: 12px; cursor: pointer; }
  @media (max-width: 560px) { input { font-size: 16px; } }
</style>
