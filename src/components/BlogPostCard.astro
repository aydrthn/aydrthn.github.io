---
import { blogCategories, formatPostDate, type BlogPost } from '../lib/blog';
import MaterialIcon from './MaterialIcon.astro';
import PosterCover from './PosterCover.astro';
interface Props { post: BlogPost; }
const { post } = Astro.props;
const { title, description, pubDate, lang, cover, coverAlt } = post.entry.data;
const coverSizes = '(max-width: 560px) calc(35vw - 14px), (max-width: 800px) min(calc(35vw - 16.8px), 250px), min(calc(35vw - 33.6px), 250px)';
---
<article>
  <a class:list={['post-card', { 'has-cover': cover }]} data-liquid-glass href={post.href}>
    {cover && (
      <div class="post-cover">
        <PosterCover src={cover} alt={coverAlt} fill sizes={coverSizes} />
      </div>
    )}
    <div class="post-details">
      <div class="post-copy">
        <div class="post-meta">
          <span>{blogCategories[post.category].label}</span>
          <span aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
        </div>
        <h3 lang={lang}>{title}</h3>
        <p lang={lang}>{description}</p>
      </div>
      <MaterialIcon name="arrow_forward" class="post-arrow" />
    </div>
  </a>
</article>
<style>
  .post-card { display: block; transition: border-color 180ms, box-shadow 180ms; }
  /* Share one responsive cover column across all blog categories. */
  .post-card.has-cover {
    display: grid;
    grid-template-columns: minmax(0, min(var(--blog-cover-share), var(--blog-cover-max))) minmax(0, 1fr);
  }
  .post-cover { position: relative; min-height: 180px; background: var(--soft); border-radius: calc(var(--glass-radius) - 1px) 0 0 calc(var(--glass-radius) - 1px); overflow: hidden; }
  .post-details { display: flex; align-items: center; gap: 24px; min-width: 0; padding: 24px 28px; }
  .post-card:hover { border-color: var(--glass-highlight); box-shadow: 0 0 18px -1px var(--glass-shadow), 0 18px 38px -14px var(--glass-shadow), inset 0 1px 0 var(--glass-highlight); }
  .post-copy { flex: 1; min-width: 0; }
  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; font-size: 12px; color: var(--muted); }
  h3 { margin: 10px 0 8px; font-size: 21px; overflow-wrap: anywhere; }
  p { color: var(--muted); font-size: 14px; overflow-wrap: anywhere; }
  :global(.post-arrow) { color: var(--accent); }
  .has-cover p { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  @media (max-width: 560px) {
    .post-details { padding: 20px; gap: 16px; }
    .has-cover .post-details { padding: 16px; gap: 10px; }
    .has-cover :global(.post-arrow) { display: none; }
    h3 { font-size: 19px; }
    .has-cover h3 { font-size: 17px; }
    .has-cover .post-meta { font-size: 11px; gap: 6px; }
    .has-cover p { font-size: 13px; }
  }
</style>
