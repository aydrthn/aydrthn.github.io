---
import BaseLayout from './BaseLayout.astro';
import { blogCategories, formatPostDate, type BlogPost } from '../lib/blog';
interface Props { post: BlogPost; }
const { post } = Astro.props;
const { title, description, pubDate, lang } = post.entry.data;
const category = blogCategories[post.category];
---
<BaseLayout title={`${title} — Aydrthn Blog`} description={description} section="blog" ogType="article">
  <article class="blog-post">
    <header class="post-header">
      <a class="text-link" href={category.href}>← Back to {category.label}</a>
      <div class="post-meta">
        <span>{category.label}</span>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
      </div>
      <h1 lang={lang}>{title}</h1>
    </header>
    <div class="post-body" lang={lang}><slot /></div>
    <footer class="post-footer"><a class="text-link" href={category.href}>← Back to {category.label}</a></footer>
  </article>
</BaseLayout>
<style>
  .blog-post { max-width: 760px; margin-inline: auto; }
  .post-header { padding: var(--page-intro-top) 0 36px; border-bottom: 1px solid var(--border); }
  .post-meta { display: flex; align-items: center; gap: 10px; margin: 36px 0 16px; font-size: 12px; color: var(--muted); }
  h1 { font-size: clamp(30px, 4.5vw, 46px); line-height: 1.4; letter-spacing: -0.8px; overflow-wrap: anywhere; }
  .post-body { padding-top: 36px; font-size: 17px; line-height: 1.95; overflow-wrap: anywhere; }
  .post-body :global(p), .post-body :global(ul), .post-body :global(ol) { margin: 0 0 24px; }
  .post-body :global(h2) { margin: 44px 0 20px; font-size: 26px; line-height: 1.4; }
  .post-body :global(h3), .post-body :global(h4), .post-body :global(h5), .post-body :global(h6) { margin: 32px 0 16px; line-height: 1.5; }
  .post-body :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .post-body :global(img) { display: block; max-width: 100%; height: auto; object-fit: contain; margin: 32px auto; border-radius: 10px; }
  .post-body :global(figure) { max-width: 100%; margin: 32px auto; }
  .post-body :global(figure img) { margin-block: 0; }
  .post-body :global(blockquote) { margin: 28px 0; padding: 18px 24px; border-left: 3px solid var(--accent); border-radius: 0 10px 10px 0; background: var(--soft); }
  .post-body :global(blockquote > :last-child) { margin-bottom: 0; }
  .post-body :global(pre) { padding: 20px; border: 1px solid var(--border); border-radius: 10px; overflow-x: auto; font-size: 14px; line-height: 1.7; }
  .post-body :global(:not(pre) > code) { padding: 2px 5px; border-radius: 4px; background: var(--soft); font-size: 0.9em; }
  .post-body :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin-bottom: 24px; font-size: 15px; }
  .post-body :global(th), .post-body :global(td) { padding: 10px 14px; border: 1px solid var(--border); text-align: left; }
  .post-body :global(hr) { margin: 36px 0; border: 0; border-top: 1px solid var(--border); }
  .post-footer { margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--border); }
  @media (max-width: 560px) {
    .post-body { font-size: 16px; }
    .post-body :global(h2) { font-size: 23px; }
    .post-body :global(blockquote) { padding: 16px 18px; }
  }
</style>
