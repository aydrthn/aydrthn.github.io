---
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogPostList from '../../components/BlogPostList.astro';
import { getBlogPosts } from '../../lib/blog';
const posts = await getBlogPosts('notes');
---
<BlogLayout title="Notes" eyebrow="BLOG / NOTES">
  <BlogPostList posts={posts} heading="Latest notes" emptyMessage="No notes yet." />
</BlogLayout>
