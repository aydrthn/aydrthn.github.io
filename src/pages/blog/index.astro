---
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogPostList from '../../components/BlogPostList.astro';
import { getBlogPosts } from '../../lib/blog';
const posts = await getBlogPosts('essays');
---
<BlogLayout title="Blog" eyebrow="BLOG / ESSAYS">
  <BlogPostList posts={posts} heading="Latest essays" emptyMessage="No essays yet." />
</BlogLayout>
