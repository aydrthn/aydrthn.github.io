---
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogPostList from '../../components/BlogPostList.astro';
import { getBlogPosts } from '../../lib/blog';
const posts = await getBlogPosts('archive');
---
<BlogLayout title="Archive" eyebrow="BLOG / ARCHIVE">
  <BlogPostList posts={posts} heading="Latest archived posts" emptyMessage="No archived posts yet." />
</BlogLayout>
