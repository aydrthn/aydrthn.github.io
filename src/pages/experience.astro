---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Timeline, { type TimelineEntry } from '../components/Timeline.astro';
const education: TimelineEntry[] = [
  {
    title: 'ShanghaiTech University',
    startDate: '2023',
    date: '2023–2027 (expected)',
    subtitle: 'B.S. in Computer Science · China',
    details: [
      'GPA: 3.52/4.00 · Major GPA: 3.88/4.00.',
      'Coursework: Computer Architecture, Parallel Programming, Machine Learning, and Artificial Intelligence.',
    ],
  },
  {
    title: 'University of Illinois Urbana-Champaign',
    startDate: '2025',
    date: '2025–2026',
    subtitle: 'Computer Science exchange student · United States',
    details: [
      'GPA: 3.83/4.00 · Dean’s List, Fall 2025.',
      'Coursework: Parallel Programming, Systems Programming, Database Systems, Applied Machine Learning, and Computer Systems.',
    ],
  },
  {
    title: 'Duke Kunshan University',
    startDate: '2024-07',
    date: 'July 2024',
    subtitle: 'Global Health Summer Program · China',
    details: [
      'Completed an English-taught program on global health challenges, public health systems, health equity, and sustainable development.',
      'Explored global health issues through case studies and project presentations, working with students from different academic backgrounds.',
    ],
  },
  {
    title: 'ShanghaiTech University',
    startDate: '2027',
    date: '2027–2030 (expected)',
    subtitle: 'Academic Master’s Degree · China',
  },
];
const community: TimelineEntry[] = [
  {
    title: 'ShanghaiTech University Student Union',
    startDate: '2023',
    date: '2023–Present',
    subtitle: 'Staff Member · New Media Department',
  },
];
---
<BaseLayout title="Experience — Aydrthn">
  <PageIntro eyebrow="EXPERIENCE" title="The journey so far." />
  <section class="split-section" aria-labelledby="education-title">
    <h2 id="education-title">Education & learning</h2>
    <Timeline entries={education} />
  </section>
  <section class="split-section" aria-labelledby="community-title">
    <h2 id="community-title">Campus & community</h2>
    <Timeline entries={community} />
  </section>
</BaseLayout>
